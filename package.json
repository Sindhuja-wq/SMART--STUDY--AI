{
  "name": "smart-study-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.prisma && next dev",
    "build": "prisma generate --schema=prisma/schema.postgresql.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/test_quality_audit.mjs",
    "postinstall": "prisma generate --schema=prisma/schema.postgresql.prisma && (prisma skills sync || exit 0)"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.53.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
