# ========================================================
# SMART STUDY AI - ENVIRONMENT VARIABLES
# Copy this file to .env.local for development
# Add these values in the Vercel Dashboard for production
# ========================================================

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION
# --------------------------------------------------------
# Local SQLite Development (Used by prisma/schema.prisma):
DATABASE_URL="file:./dev.db"

# Production Neon PostgreSQL (Used by prisma/schema.postgresql.prisma on Vercel):
# Copy the pooled connection string from your Neon Dashboard (https://console.neon.tech)
# and add it to your Vercel Project Environment Variables:
NEON_DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION
# --------------------------------------------------------
# A random 32-character secret string. In terminal, generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-strong-random-32-character-secret-key"

# In local development: http://localhost:3000
# In production on Vercel: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --------------------------------------------------------
# 3. AI PROVIDER CONFIGURATION
# --------------------------------------------------------
# AI_PROVIDER options:
# "auto" (default) -> Detects GROQ_API_KEY first, then GEMINI_API_KEY, then OLLAMA_URL
# "ollama" -> Connects to local or remote Ollama instance
# "groq" -> Uses Groq Cloud (Free tier Llama models)
# "gemini" -> Uses Google Gemini API (Free tier)
AI_PROVIDER="auto"

# Option A: Local or Remote Ollama (Development or Self-Hosted)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Option B: Groq Cloud (Recommended free cloud AI for Llama 3.3/3.1)
# Sign up free at: https://console.groq.com
# GROQ_API_KEY="gsk_your_groq_api_key_here"
# GROQ_MODEL="llama-3.3-70b-versatile"

# Option C: Google Gemini API (Alternative free cloud AI)
# Get a free key at: https://aistudio.google.com
# GEMINI_API_KEY="your_google_gemini_api_key_here"
# GEMINI_MODEL="gemini-1.5-flash"

# --------------------------------------------------------
# 4. EMAIL OTP CONFIGURATION (Nodemailer SMTP)
# --------------------------------------------------------
# Recommended providers:
# - Resend (Free 3000 emails/mo): host: smtp.resend.com, port: 465, user: resend, pass: your_resend_api_key
# - Gmail App Password: host: smtp.gmail.com, port: 465, user: your-email@gmail.com, pass: your-app-password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Smart Study AI" <noreply@yourdomain.com>'
